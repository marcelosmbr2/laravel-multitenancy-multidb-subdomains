APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Every company answers on `{slug}.{host of APP_URL}`, so the host has to resolve with a wildcard.
# `lvh.me` and `*.lvh.me` both resolve to 127.0.0.1 through public DNS, which needs no setup:
#
#   php artisan serve --host=lvh.me --port=8000
#
# `CENTRAL_DOMAIN` is derived from `APP_URL` and only needs to be set when the two differ. Note
# that `php artisan route:cache` bakes the domain into the cached routes, so re-run it after a
# change here.
APP_URL=http://lvh.me:8000
# CENTRAL_DOMAIN=lvh.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=landlord
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave `null`. A host-scoped cookie is what keeps every company subdomain, and the administration
# panel on the bare domain, on a session of its own.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
